# Warera API key (issued by the game; needed for the 500 req/min tier).
WARERA_API_KEY=

# Upstash Redis credentials. Vercel's Upstash marketplace integration uses
# the legacy KV_REST_API_* names — keep them as-is so the same env vars work
# on Vercel and in GitHub Actions.
KV_REST_API_URL=
KV_REST_API_TOKEN=
