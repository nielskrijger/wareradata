# Warera API key (issued by the game; raises the request-rate tier).
WARERA_API_KEY=

# Directory for the persisted snapshot and battle archive. On the server this
# should point at the mounted persistent volume; locally a relative dir is fine.
DATA_DIR=./.data

# Requests/minute caps for the two API clients (each enforced independently).
# SCRAPE_RATE_LIMIT: the continuous full-scrape loop.
# URGENT_RATE_LIMIT: on-demand traffic (piecemeal MU refreshes, live battles).
# Both optional, default 100; the sum stays at the API's authenticated tier.
SCRAPE_RATE_LIMIT=100
URGENT_RATE_LIMIT=100
