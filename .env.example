# Warera API key (issued by the game; raises the request-rate tier).
WARERA_API_KEY=

# Directory for the persisted snapshot and battle archive. On the server this
# should point at the mounted persistent volume; locally a relative dir is fine.
DATA_DIR=./.data

# Requests/minute caps for the three API clients (each enforced independently).
# SCRAPE_RATE_LIMIT:  the continuous main-scrape loop.
# URGENT_RATE_LIMIT:  on-demand traffic (MU refreshes, live battles, user-page factories).
# FACTORY_RATE_LIMIT: the all-users factory scrape (boosted to finish the first pass).
# All optional; the sum (60 + 40 + 100) stays at the API's authenticated tier (200).
SCRAPE_RATE_LIMIT=60
URGENT_RATE_LIMIT=40
FACTORY_RATE_LIMIT=100
